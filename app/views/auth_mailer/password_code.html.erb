<!DOCTYPE html>
<html>
<body style="font-family: sans-serif; max-width: 480px; margin: 0 auto; padding: 32px 16px; color: #392316;">
  <h2 style="font-size: 22px; margin-bottom: 8px;">Your Cayado code</h2>
  <p style="color: #555; margin-bottom: 16px;">Enter this code to set your password. It works for 15 minutes.</p>
  <p style="font-size: 32px; font-weight: 700; letter-spacing: 8px; margin: 0 0 24px;"><%= code %></p>
  <a href="<%= link %>"
     style="display:inline-block;background:#c66846;color:#fff;padding:12px 28px;border-radius:99px;text-decoration:none;font-weight:600;">
    Set your password
  </a>
  <p style="margin-top: 24px; font-size: 12px; color: #aaa;">
    If you didn't ask for this, you can ignore this email. Your password hasn't changed.
  </p>
</body>
</html>
