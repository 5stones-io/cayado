<!DOCTYPE html>
<html>
<body style="font-family: sans-serif; max-width: 480px; margin: 0 auto; padding: 32px 16px; color: #392316;">
  <p style="font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: #c66846; margin-bottom: 4px;"><%= ERB::Util.h(church_name) %></p>
  <h2 style="font-size: 22px; margin-bottom: 8px;"><%= ERB::Util.h(subject) %></h2>
  <p style="color: #555; margin-bottom: 24px; white-space: pre-line;"><%= ERB::Util.h(body) %></p>
  <a href="<%= ERB::Util.h(link) %>" style="display: inline-block; background: #c66846; color: #fff; text-decoration: none; padding: 10px 18px; border-radius: 6px;">Open in Cayado</a>
</body>
</html>
